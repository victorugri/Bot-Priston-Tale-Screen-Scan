<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop UI: edit the day-to-day settings, Play/Pause/Stop, live stats and log. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>BotPristonUi</AssemblyName>
    <RootNamespace>BotPriston.Ui</RootNamespace>
    <!-- Per-monitor DPI awareness, like the console app, so screen coordinates are physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BotPriston.Hosting\BotPriston.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
